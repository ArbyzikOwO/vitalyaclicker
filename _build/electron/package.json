{
  "name": "vitalyaclicker",
  "productName": "VitalyaClicker",
  "version": "1.0.6",
  "description": "VitalyaClicker — кликер-игра с онлайн-режимом",
  "author": "VitalyaClicker",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArbyzikOwO/vitalyaclicker.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.vitalyaclicker.app",
    "productName": "VitalyaClicker",
    "copyright": "VitalyaClicker",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "stage/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "VitalyaClicker.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
