; VitalyaClicker 69 — перенос на Godot 4, этап 1: оффлайн-игра.
; Готово: клик, апгрейды, скины и крафт, казино, крипта, майнинг,
; кредиты, новости, достижения, сохранение и оффлайн-доход.
; Дальше: аккаунты и облако, чат, карты, работа, сад.
; Открыть: Godot 4.x → Import → выбрать эту папку (project.godot).
; Запуск: F5 или run-godot.cmd.

config_version=5

[application]

config/name="VitalyaClicker 69 — Godot"
config/description="Перенос кликера на Godot, этап 1: оффлайн-игра (клик, апгрейды, скины, казино, крипта, майнинг, кредиты, достижения)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.078, 1)
